# Server-side only. Store the real key in Vercel Sensitive Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender domain must be verified in Resend.
AMA_FROM_EMAIL=AMA Solutions <info@amasolagi.com>
AMA_CONTACT_TO_EMAIL=info@amasolagi.com
AMA_REPLY_TO_EMAIL=major@amasolagi.com

# Resend audience topic and custom event configured for AMA website signups.
RESEND_MARKETING_TOPIC_ID=
RESEND_MARKETING_EVENT=ama.website.marketing_subscribed
